# Copy to apps/worker/.env for local development. Do not commit the real .env file.
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/scopepilot

# Optional. Comma-separated DNS server IPs for MongoDB SRV lookups (omit to use system DNS).
# Useful on Windows when Node's resolver fails with ECONNREFUSED for mongodb+srv URIs.
MONGODB_DNS_SERVERS=8.8.8.8,8.8.4.4

# Optional. Google PageSpeed Insights API key for performance analysis (worker only; never sent to the browser).
# When empty, audits record performance as "unavailable" and complete as "partial".
PAGESPEED_API_KEY=
