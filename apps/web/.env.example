# Base URL of the ScopePilot API. Browser requests go to this Next.js server (/api/v1/*),
# which forwards them server-side, so the API and its keys are never exposed to the browser.
SCOPEPILOT_API_URL=http://localhost:4000

# Optional. Extra comma-separated origins allowed to make state-changing requests (sign-in, saves) when the
# public site origin differs from the URL this server sees, e.g. behind a reverse proxy. Same-origin is always allowed.
SCOPEPILOT_ALLOWED_ORIGINS=
