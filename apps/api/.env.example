# Copy to apps/api/.env for local development. Do not commit the real .env file.
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/scopepilot
PORT=4000

# Sessions (server-managed, HTTP-only cookie). All optional; the defaults are shown.
# Secure cookies default to true when NODE_ENV=production and cannot be disabled there.
# Leave false for local HTTP development (http://localhost).
SESSION_COOKIE_SECURE=false
# Absolute session lifetime and inactivity timeout, in hours.
SESSION_TTL_HOURS=168
SESSION_IDLE_HOURS=24
# Express "trust proxy" value: which proxies may supply X-Forwarded-For (used by login/registration rate limits).
# The default trusts only the local Next.js server. Behind another reverse proxy, set its address or hop count.
API_TRUST_PROXY=loopback
# Required when this API has a public URL: requests without this shared secret get 404, and rate limits use
# the client address reported by the web proxy. Set the same value on the web app. At least 32 characters;
# generate with `openssl rand -hex 32`. Leave empty when the API is reachable only from the web server.
SCOPEPILOT_PROXY_SECRET=

# Optional. Comma-separated DNS server IPs for MongoDB SRV lookups (omit to use system DNS).
# Useful on Windows when Node's resolver fails with ECONNREFUSED for mongodb+srv URIs.
MONGODB_DNS_SERVERS=8.8.8.8,8.8.4.4

# Optional. Enables AI interpretation of verified findings (Google Gemini). Server-side only; never
# expose it to the web app. Without it, the report shows AI interpretation as "not configured".
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.8-flash.
GEMINI_MODEL=
